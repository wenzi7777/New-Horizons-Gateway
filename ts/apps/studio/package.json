{
  "name": "@nhgw/studio",
  "productName": "NH Studio",
  "version": "2.6.0",
  "private": true,
  "description": "New Horizons Studio: manage TIA-CTL devices on this computer, record, and relay to the New Horizons server.",
  "main": "dist/main/main.cjs",
  "author": "New Horizons",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "build:main": "node scripts/build-main.mjs",
    "start": "electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "jp.ac.uaizu.newhorizons.studio",
    "productName": "NH Studio",
    "copyright": "New Horizons Studio, University of Aizu",
    "electronVersion": "45.2.3",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "artifactName": "NH-Studio-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "../../../brand/macos/nh-studio.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "NH Studio talks to New Horizons devices on your local network (UDP discovery and data streaming)."
      }
    },
    "dmg": {
      "title": "NH Studio ${version}"
    },
    "win": {
      "icon": "../../../brand/windows/nh-studio.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "NH Studio",
      "uninstallDisplayName": "New Horizons Studio"
    },
    "publish": null,
    "linux": {
      "icon": "../../../brand/png/nh-studio-1024.png",
      "category": "Development",
      "executableName": "nh-studio-app",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "synopsis": "New Horizons Studio"
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@nhgw/core": "*",
    "@nhgw/engine": "*",
    "@nhgw/host": "*",
    "@nhgw/ui-tokens": "*",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.70.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0",
    "vite": "^8.3.7"
  }
}
