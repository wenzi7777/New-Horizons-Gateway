{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "test", "vite.config.ts", "scripts"],
  // app.ts examples and their API declare device globals (on, event, led...)
  // that would leak into the app; they are checked in the App Library.
  "exclude": ["src/renderer/areas/apps/sdk/examples", "src/renderer/areas/apps/sdk/types"]
}
