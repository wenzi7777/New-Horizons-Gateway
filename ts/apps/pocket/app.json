{
  "expo": {
    "name": "NH Pocket",
    "slug": "nh-pocket",
    "scheme": "nhpocket",
    "version": "2.14.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "jp.ac.uaizu.newhorizons.pocket"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f6b54",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "jp.ac.uaizu.newhorizons.pocket",
      "versionCode": 26
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "nickhsu",
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "# expo-gl: GLView extends TextureView (not ExpoView), so expo-modules-core's\n# keep rule misses the (Context, AppContext) constructor the view manager\n# calls by reflection; R8 stripped it and switching to 3D crashed. The JNI\n# side (EXGL) is looked up by name too.\n-keep class expo.modules.gl.** { *; }\n"
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "78b78e58-30a4-4b38-a55f-8dbda1f4ca7f"
      }
    }
  }
}
